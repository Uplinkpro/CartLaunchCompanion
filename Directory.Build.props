<Project>
  <PropertyGroup>
    <VersionPrefix>2.5.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>2.5.0.0</AssemblyVersion>
    <FileVersion>2.5.0.0</FileVersion>
    <Authors>Uplinkpro</Authors>
    <Company>Cart Launch Companion</Company>
    <Product>Cart Launch Companion</Product>
    <Description>A portable, controller-first game launcher for Windows, Linux, and SteamOS.</Description>
    <RepositoryUrl>https://github.com/Uplinkpro/CartLaunchCompanion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
