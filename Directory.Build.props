<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Uplinkpro</Authors>
    <Company>Cart Launch Companion</Company>
    <Product>Cart Launch Companion</Product>
    <Description>A portable, controller-first Windows game launcher.</Description>
    <RepositoryUrl>https://github.com/Uplinkpro/CartLaunchCompanion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
