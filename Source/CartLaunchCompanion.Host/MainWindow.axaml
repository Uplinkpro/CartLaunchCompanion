<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CartLaunchCompanion.Host.MainWindow" Title="Cart Launch Host" Width="900" Height="720"
        MinWidth="760" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid Margin="30" RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <StackPanel Spacing="6">
      <TextBlock FontSize="32" FontWeight="Bold" Text="Cart Launch Host"/>
      <TextBlock Classes="help" Text="Optional per-user support for trusted physical game carts. It never installs a service, driver, administrator component, or system-wide Linux rule."/>
    </StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Install &amp; repair"><ScrollViewer><StackPanel Margin="8,18" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="10">
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="What will be installed"/>
          <TextBlock Text="{Binding InstallPurpose}" TextWrapping="Wrap"/>
          <TextBlock FontWeight="SemiBold" Text="Local component"/><TextBlock Classes="help" Text="{Binding InstallDirectory}"/>
          <TextBlock FontWeight="SemiBold" Text="Local data"/><TextBlock Classes="help" Text="{Binding DataDirectory}"/>
          <TextBlock FontWeight="SemiBold" Text="Automatic startup"/><TextBlock Classes="help" Text="{Binding StartupRegistration}"/>
          <TextBlock FontWeight="SemiBold" Text="Settings"/><TextBlock Classes="help" Text="{Binding SettingsPath}"/>
          <TextBlock FontWeight="SemiBold" Text="Trusted carts"/><TextBlock Classes="help" Text="{Binding TrustDatabasePath}"/>
          <TextBlock FontWeight="SemiBold" Text="Logs"/><TextBlock Classes="help" Text="{Binding LogsDirectory}"/>
        </StackPanel></Border>
        <CheckBox x:Name="InstallConfirm" Content="I understand these per-user changes and want to install or repair Cart Launch Host."/>
        <Button Content="Install or repair" HorizontalAlignment="Left" Background="#2F80ED" Foreground="White" Click="InstallClicked"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Trusted carts"><Grid Margin="8,18" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Classes="help" Text="Trusting a cart records its identity on this computer. Automatic launch is a separate approval and remains off unless explicitly enabled."/>
        <ListBox Grid.Row="1" ItemsSource="{Binding TrustedCarts}" SelectedItem="{Binding SelectedCart}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8" Spacing="3"><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Classes="help" Text="{Binding CartId}"/><TextBlock Classes="help" Text="{Binding ApprovalText}"/></StackPanel></DataTemplate>
        </ListBox.ItemTemplate></ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="Trust connected cart…" Click="TrustClicked"/><Button Content="Revoke selected" Click="RevokeClicked"/></StackPanel>
      </Grid></TabItem>
      <TabItem Header="Uninstall"><ScrollViewer><StackPanel Margin="8,18" Spacing="14">
        <Border Classes="card"><StackPanel Spacing="8"><TextBlock FontSize="20" FontWeight="SemiBold" Text="Remove the local component"/><TextBlock Classes="help" Text="Stops automatic startup and removes the Cart Launch Host runtime. Connected carts are never modified."/></StackPanel></Border>
        <CheckBox x:Name="RemoveTrust" Content="Also remove all trusted-cart approvals"/>
        <CheckBox x:Name="RemoveSettings" Content="Also remove Host settings"/>
        <CheckBox x:Name="RemoveLogs" Content="Also remove Host logs"/>
        <CheckBox x:Name="UninstallConfirm" Content="I understand exactly what will be removed."/>
        <Button Content="Uninstall local component" HorizontalAlignment="Left" Background="#8C3341" Foreground="White" Click="UninstallClicked"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Classes="card"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
