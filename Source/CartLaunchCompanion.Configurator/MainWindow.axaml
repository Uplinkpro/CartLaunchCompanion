<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CartLaunchCompanion.Configurator"
        x:Class="CartLaunchCompanion.Configurator.MainWindow"
        Title="Cart Launch Companion — Game Configurator"
        Icon="/Assets/AppIcon.png"
        Width="1280" Height="820" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <local:LauncherKindDisplayConverter x:Key="LauncherKindDisplayConverter"/>
    <DataTemplate x:Key="LauncherKindTemplate">
      <TextBlock Text="{Binding Converter={StaticResource LauncherKindDisplayConverter}}"/>
    </DataTemplate>
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="#10141A" BorderBrush="#2A313B" BorderThickness="0,0,0,1" Padding="24,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock FontSize="26" FontWeight="Bold" Text="Game Configurator"/>
          <TextBlock Foreground="#AAB2BE" Margin="0,4,0,0" Text="Create each game's CLC configuration inside CartLaunchCompanion/Games—without editing JSON by hand."/>
          <TextBlock Foreground="#77818E" FontSize="12" Margin="0,7,0,0" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ComboBox Width="250" PlaceholderText="No saved games"
                    ItemsSource="{Binding ExistingGames}"
                    SelectedItem="{Binding SelectedExistingGame}"
                    IsVisible="{Binding HasExistingGames}"
                    SelectionChanged="ExistingGameChanged"/>
          <Button Content="Settings" Click="SettingsClicked"/>
          <Button Content="Emulator Library" Click="EmulatorLibraryClicked"/>
          <Button Content="Prepare physical cart" Click="CreateCartClicked"/>
          <Button Content="New" Click="NewClicked"/>
          <Button Content="New Platform" Click="NewPlatformClicked"
                  ToolTip.Tip="Copy the current game into a new platform configuration."/>
          <Button Content="Open game.json" Click="OpenClicked"/>
          <Button Content="Change CLC folder" Click="ChooseFolderClicked"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="EditorTabs" Grid.Row="1" Margin="20" SelectionChanged="EditorTabsChanged">
      <TabItem Header="1  Game details">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900">
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Game details"/><TextBlock Classes="help" Margin="0,4,0,20" Text="The information people see on the home and details screens."/>
            <local:LabeledField Label="Game name" Requirement="Required" Description="The title shown in Cart Launch Companion. Find on Steam can fill the remaining metadata after you choose the exact edition."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,12,Auto"><TextBox Text="{Binding Configuration.Game.Name}" PlaceholderText="Example: Grand Theft Auto V"/><Button Grid.Column="2" Content="Find on Steam" Click="FindOnSteamClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Sort name" Description="Optional. Use this when the game should be alphabetized differently, such as ignoring “The”."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.SortName}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,14">
            <StackPanel Spacing="8">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Platform versions"/>
              <TextBlock Classes="help" Text="Optional. Give PC, PSP, PS2, or other releases the same Version group. CLC will show one shelf card, then let the player choose a version by cover art before opening metadata." TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <local:LabeledField Label="Version group" Description="Optional. Use the exact same short identifier for every version, such as gta-vice-city-stories."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.VersionGroup}" PlaceholderText="Example: gta-vice-city-stories"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Platform label" Description="Recommended for grouped games. This appears below the version cover, such as PC, PSP, or PlayStation 2."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.PlatformLabel}" PlaceholderText="Example: PSP"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Primary shelf version" Description="Optional. Choose one version to provide the cover shown on the main shelf. If none is selected, CLC uses the first sorted version."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Game.PrimaryVersion}" OnContent="Primary version" OffContent="Alternate version"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Description" Description="Optional. A short summary shown on the metadata page."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.Description}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"/></local:LabeledField.FieldContent></local:LabeledField>
            <Grid ColumnDefinitions="*,20,*">
              <local:LabeledField Label="Developer" Description="Optional. The studio that made the game."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.Developer}"/></local:LabeledField.FieldContent></local:LabeledField>
              <local:LabeledField Grid.Column="2" Label="Publisher" Description="Optional. The company that published the game."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.Publisher}"/></local:LabeledField.FieldContent></local:LabeledField>
            </Grid>
            <Grid ColumnDefinitions="*,20,*">
              <local:LabeledField Label="Genre" Description="Optional. A simple category such as Action or Racing."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.Genre}"/></local:LabeledField.FieldContent></local:LabeledField>
              <local:LabeledField Grid.Column="2" Label="Release date" Description="Optional. A year or full date, such as 2013 or 2013-09-17."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.ReleaseDate}"/></local:LabeledField.FieldContent></local:LabeledField>
            </Grid>
            <Grid ColumnDefinitions="*,20,*">
              <local:LabeledField Label="Players" Description="Optional. Examples: Single-player, 1–4, or Online multiplayer."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Game.Players}"/></local:LabeledField.FieldContent></local:LabeledField>
              <local:LabeledField Grid.Column="2" Label="Gamepad support" Description="Optional. Shows whether the game works fully or partly with a controller."><local:LabeledField.FieldContent><ComboBox ItemsSource="{Binding GamepadRatings}" SelectedItem="{Binding Configuration.Game.GamepadSupport}"/></local:LabeledField.FieldContent></local:LabeledField>
            </Grid>
            <local:LabeledField Label="Steam Deck compatibility" Description="Optional. The game’s Steam Deck rating, if known."><local:LabeledField.FieldContent><ComboBox ItemsSource="{Binding DeckRatings}" SelectedItem="{Binding Configuration.Game.SteamDeckCompatibility}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Private notes" Description="Optional. Notes for the person maintaining this configuration; not needed to launch the game."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Notes}" AcceptsReturn="True" MinHeight="70"/></local:LabeledField.FieldContent></local:LabeledField>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="2  Artwork &amp; media">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900" Spacing="16">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel><TextBlock Classes="section" Text="Metadata page preview"/><TextBlock Classes="help" Text="An approximate preview of how the current cover, background, logo, and icon work together on the game-details screen."/></StackPanel>
                <Button Grid.Column="1" Content="Refresh previews" Click="RefreshArtworkClicked"/>
              </Grid>
              <Border Width="800" Height="450" HorizontalAlignment="Center" Background="#080A0D"
                      BorderBrush="#3A4451" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding BackgroundPreview}" Stretch="UniformToFill" IsVisible="{Binding HasBackgroundPreview}"/>
                  <Image Source="{Binding HeroPreview}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsVisible="{Binding HasHeroOnlyPreview}"/>
                  <TextBlock Text="HERO OR 16:9 BACKGROUND MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasStagePreview}"/>
                  <Border><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#26000000" Offset="0"/><GradientStop Color="#FF000000" Offset="0.78"/></LinearGradientBrush></Border.Background></Border>
                  <Image Source="{Binding LogoPreview}" Width="300" Height="92" Stretch="Uniform"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,28,0,0" IsVisible="{Binding HasLogoPreview}"/>
                  <Border Width="76" Height="76" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,26,30,0" Background="#D0101318" CornerRadius="10" Padding="8">
                    <Grid><Image Source="{Binding IconPreview}" Stretch="Uniform" IsVisible="{Binding HasIconPreview}"/><TextBlock Text="ICON" Foreground="#707986" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIconPreview}"/></Grid>
                  </Border>
                  <Border Width="156" Height="218" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="34,0,0,30" Background="#D0101318" CornerRadius="8" Padding="5">
                    <Grid><Image Source="{Binding CoverPreview}" Stretch="Uniform" IsVisible="{Binding HasCoverPreview}"/><TextBlock Text="COVER" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasCoverPreview}"/></Grid>
                  </Border>
                  <Border Width="530" Height="190" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,30,30" Background="#D9101318" CornerRadius="10" Padding="24">
                    <StackPanel Spacing="10"><TextBlock Text="{Binding Configuration.Game.Name}" FontSize="25" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Configuration.Game.Description}" Foreground="#CFFFFFFF" FontSize="14" MaxHeight="82" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><Border Height="38" Width="190" HorizontalAlignment="Right" Background="#2F80ED" CornerRadius="5"><TextBlock Text="LAUNCH" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Automatic metadata"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Steam is the simplest way to fill missing artwork and game information."/>
            <local:LabeledField Label="Steam metadata ID" Description="Optional. The number in the game’s Steam store address. It can be used even when the game launches elsewhere."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.SteamMetadataId}" PlaceholderText="Example: 3240220"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="SteamGridDB game ID" Description="Optional. Identifies artwork for non-Steam, delisted, console, and emulated games. Find on Steam can populate this from a title match."><local:LabeledField.FieldContent><NumericUpDown Value="{Binding Configuration.Artwork.SteamGridDbGameId}" Minimum="1" Maximum="9223372036854775807"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Download missing artwork" Description="Optional. When enabled, the launcher tries online sources if local artwork is missing."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Artwork.DownloadMissingArtwork}" OnContent="Enabled" OffContent="Disabled"/></local:LabeledField.FieldContent></local:LabeledField>
            <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="Refresh metadata and downloaded artwork"/><TextBlock Classes="help" Text="Fills missing game details and redownloads API-managed cover, hero, logo, icon, and screenshots. Your custom 16:9 background and local trailer are preserved."/></StackPanel>
                <Button Grid.Column="1" Content="Update metadata and artwork" Click="RefreshApiArtworkClicked" Margin="14,0,0,0"/>
              </Grid>
            </Border>
            <Button Content="Browse SteamGridDB artwork" Click="BrowseSteamGridDbArtworkClicked" HorizontalAlignment="Left"/>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Local files"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Paths are normally relative to this game folder. Keep the defaults when using the standard Artwork and Media folders."/>
            <local:LabeledField Label="Cover art" Description="Optional. Portrait cover image shown on the shelf."><local:LabeledField.FieldContent><StackPanel Spacing="8"><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Artwork.Cover}"/><Button Grid.Column="2" Content="Delete file" Tag="cover" Click="DeleteArtworkClicked"/></Grid><Border Height="190" Background="#080A0D" CornerRadius="7" Padding="6"><Grid><Image Source="{Binding CoverPreview}" Stretch="Uniform" IsVisible="{Binding HasCoverPreview}"/><TextBlock Text="COVER MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasCoverPreview}"/></Grid></Border></StackPanel></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Hero" Description="Optional. Wide artwork, usually around 1920 × 620, placed across the top and faded into true black. Steam supplies this automatically."><local:LabeledField.FieldContent><StackPanel Spacing="8"><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Artwork.Hero}"/><Button Grid.Column="2" Content="Delete file" Tag="hero" Click="DeleteArtworkClicked"/></Grid><Border Height="150" Background="#080A0D" CornerRadius="7" Padding="6"><Grid><Image Source="{Binding HeroPreview}" Stretch="Uniform" IsVisible="{Binding HasHeroPreview}"/><TextBlock Text="HERO MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasHeroPreview}"/></Grid></Border></StackPanel></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="16:9 background" Description="Optional. A user-supplied full-screen 16:9 image. When present, it takes priority over the scraped hero."><local:LabeledField.FieldContent><StackPanel Spacing="8"><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Artwork.Background}"/><Button Grid.Column="2" Content="Delete file" Tag="background" Click="DeleteArtworkClicked"/></Grid><Border Height="220" Background="#080A0D" CornerRadius="7" Padding="6"><Grid><Image Source="{Binding BackgroundPreview}" Stretch="Uniform" IsVisible="{Binding HasBackgroundPreview}"/><TextBlock Text="16:9 BACKGROUND MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasBackgroundPreview}"/></Grid></Border></StackPanel></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Logo" Description="Optional. Transparent game logo displayed in the header."><local:LabeledField.FieldContent><StackPanel Spacing="8"><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Artwork.Logo}"/><Button Grid.Column="2" Content="Delete file" Tag="logo" Click="DeleteArtworkClicked"/></Grid><Border Height="150" Background="#080A0D" CornerRadius="7" Padding="6"><Grid><Image Source="{Binding LogoPreview}" Stretch="Uniform" IsVisible="{Binding HasLogoPreview}"/><TextBlock Text="LOGO MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasLogoPreview}"/></Grid></Border></StackPanel></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Icon" Description="Optional. Small square game or launcher icon."><local:LabeledField.FieldContent><StackPanel Spacing="8"><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Artwork.Icon}"/><Button Grid.Column="2" Content="Delete file" Tag="icon" Click="DeleteArtworkClicked"/></Grid><Border Width="170" Height="170" HorizontalAlignment="Left" Background="#080A0D" CornerRadius="7" Padding="6"><Grid><Image Source="{Binding IconPreview}" Stretch="Uniform" IsVisible="{Binding HasIconPreview}"/><TextBlock Text="ICON MISSING" Foreground="#707986" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIconPreview}"/></Grid></Border></StackPanel></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Local trailer" Description="Optional. A local video such as Media/Trailer.mp4 or snap.mp4."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.Trailer}"/></local:LabeledField.FieldContent></local:LabeledField>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Direct download addresses"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Optional fallbacks. Paste a direct web address only when you want to override automatic metadata."/>
            <local:LabeledField Label="Cover URL" Description="Optional. Direct address for a portrait cover image."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.CoverUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Hero URL" Description="Optional. Direct address for wide hero artwork."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.HeroUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="16:9 background URL" Description="Optional. Direct address for a full-screen 16:9 background."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.BackgroundUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Logo URL" Description="Optional. Direct address for a transparent logo."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.LogoUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Icon URL" Description="Optional. Direct address for a square icon."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.IconUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Trailer URL" Description="Optional. A YouTube link or direct video address used when no local trailer is available."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Artwork.TrailerUrl}"/></local:LabeledField.FieldContent></local:LabeledField>
            <Border Background="#102419" BorderBrush="#347A4D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel><TextBlock FontWeight="SemiBold" Text="Download files into this game configuration"/><TextBlock Classes="help" Text="Downloads the supplied cover, hero, 16:9 background, logo, icon, and direct video URLs; validates images; updates local paths; and saves game.json."/></StackPanel>
                <Button Grid.Column="1" Content="Download artwork and save" Click="DownloadArtworkAndSaveClicked" Margin="14,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="3  Windows launch">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900"><Border Classes="card"><StackPanel>
          <TextBlock Classes="section" Text="Windows launch"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Choose how this game starts on Windows. Only the target matching the selected launcher is normally needed."/>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18">
            <StackPanel Spacing="10">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Use a portable emulator"/>
              <TextBlock Classes="help" Text="Choose an emulator registered in the Emulator Library. If Windows and Linux builds are both installed, CLC configures both launch targets together."/>
              <Grid ColumnDefinitions="*,10,Auto,10,Auto">
                <ComboBox ItemsSource="{Binding InstalledEmulators}" SelectedItem="{Binding SelectedInstalledEmulator}" PlaceholderText="No installed emulators found"/>
                <Button Grid.Column="2" Content="Apply to this game" Click="ApplyInstalledEmulatorClicked" IsEnabled="{Binding HasInstalledEmulators}"/>
                <Button Grid.Column="4" Content="Manage library" Click="EmulatorLibraryClicked"/>
              </Grid>
            </StackPanel>
          </Border>
          <local:LabeledField Label="Enable Windows" Requirement="Required" Description="At least Windows or Linux must be enabled."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Windows.Enabled}" OnContent="Enabled" OffContent="Disabled"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Launcher" Requirement="Required" Description="The store, launcher, direct executable, or emulator used to start the game."><local:LabeledField.FieldContent><ComboBox ItemsSource="{Binding LauncherKinds}" SelectedItem="{Binding Configuration.Launch.Windows.Launcher}" ItemTemplate="{StaticResource LauncherKindTemplate}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid ColumnDefinitions="*,Auto,8,Auto"><TextBlock Text="{Binding WindowsLauncherStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Verify selected launcher" Tag="windows" Click="VerifySelectedLauncherClicked"/><Button Grid.Column="3" Content="Locate launcher folder" Tag="windows" Click="LocateLauncherFolderClicked"/></Grid></Border>
          <TextBlock FontWeight="SemiBold" FontSize="16" Margin="0,8,0,14" Text="Launcher IDs"/>
          <local:LabeledField Label="Steam App ID" Description="Needed for Steam. The numeric ID from the Steam store page."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.SteamId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Xbox App ID" Description="Needed for Xbox or Microsoft Store launches unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.XboxAppId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Epic app name" Description="Needed for Epic Games unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.EpicAppName}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="GOG game ID" Description="Usually needed for GOG. An executable or URI can be used instead."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.GogGameId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Ubisoft game ID" Description="Needed for Ubisoft Connect unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.UbisoftGameId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Rockstar game ID" Description="Needed for Rockstar Games Launcher unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.RockstarGameId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Amazon game ID" Description="Needed for Amazon Games unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.AmazonGameId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <TextBlock FontWeight="SemiBold" FontSize="16" Margin="0,8,0,14" Text="Executable options"/>
          <Border Background="#102419" BorderBrush="#347A4D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><TextBlock Text="{Binding PathStatus}" Foreground="#AEEBC3" TextWrapping="Wrap"/></Border>
          <local:LabeledField Label="Executable" Description="Required for an EXE game or emulator. Locate saves a portable path without a drive letter."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto,8,Auto"><TextBox Text="{Binding Configuration.Launch.Windows.Executable}"/><Button Grid.Column="2" Content="Locate game" Tag="windows-game" Click="LocatePortableFileClicked"/><Button Grid.Column="4" Content="Locate emulator" Tag="windows-emulator" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Arguments" Description="Optional. Extra command-line options. Locate ROM appends a safely quoted portable game-image path."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Launch.Windows.Arguments}"/><Button Grid.Column="2" Content="Locate ROM" Tag="windows-rom" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Working directory" Description="Optional. Folder the game should treat as its starting location."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.WorkingDirectory}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,12">
            <StackPanel Spacing="7">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Emulator command-line quick reference"/>
              <TextBlock Classes="help" Text="Choose Emulator as the launcher. Put the emulator in the Executable field, use . as the working directory, and place the fullscreen recipe plus the game image in Arguments."/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="RetroArch    -f -L &quot;../../Emulators/RetroArch/cores/core_libretro.dll&quot; &quot;Game/Game.rom&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="DuckStation  -batch -fullscreen -- &quot;Game/Game.cue&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="PCSX2        -fullscreen -batch -- &quot;Game/Game.iso&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="Dolphin      -b -e &quot;Game/Game.rvz&quot;  (enable Start in Fullscreen in Dolphin)" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="RPCS3        --no-gui --fullscreen &quot;Game/Game/PS3_GAME/USRDIR/EBOOT.BIN&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="PPSSPP       --fullscreen --pause-menu-exit &quot;Game/Game.iso&quot;" TextWrapping="Wrap"/>
              <TextBlock Classes="help" Text="Keep quotes around paths with spaces. Set Process name to the emulator process so Cart Launch Companion returns when emulation ends."/>
            </StackPanel>
          </Border>
          <TextBlock FontWeight="SemiBold" FontSize="16" Margin="0,18,0,14" Text="Companion executable"/>
          <TextBlock Classes="help" Margin="0,0,0,14" Text="Optional. Start a mod manager, controller tool, trainer, or other helper immediately before the primary executable or launcher."/>
          <local:LabeledField Label="Launch companion app" Description="Optional. Enable this only when another program must start before the game."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Windows.CompanionApplication.Enabled}" OnContent="Enabled" OffContent="Disabled"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion executable" Description="Required when enabled. Locate a helper stored on the cart."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Launch.Windows.CompanionApplication.Executable}" PlaceholderText="Example: Tools/ModManager.exe"/><Button Grid.Column="2" Content="Locate companion" Tag="windows-companion" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion arguments" Description="Optional. Command-line options passed only to the companion app."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.CompanionApplication.Arguments}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion working directory" Description="Optional. Leave blank to use the game folder."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.CompanionApplication.WorkingDirectory}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Close companion after game" Description="Optional. Automatically closes the companion when Cart Launch Companion detects that the game has exited."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Windows.CompanionApplication.CloseAfterGame}" OnContent="Close automatically" OffContent="Leave running"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Process name" Description="Optional. Helps detect when the game starts and exits if its process differs from the executable."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.ProcessName}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Launch URI" Description="Optional. A custom address such as a store protocol link; it can replace a launcher ID for supported launchers."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Windows.Uri}"/></local:LabeledField.FieldContent></local:LabeledField>
        </StackPanel></Border></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="4  Linux &amp; Steam Deck">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900"><Border Classes="card"><StackPanel>
          <TextBlock Classes="section" Text="Linux and Steam Deck launch"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Leave this disabled for a Windows-only game. Steam, Heroic, Flatpak, Wine, Proton, local files, and custom URIs are supported."/>
          <local:LabeledField Label="Enable Linux" Requirement="Required" Description="At least Windows or Linux must be enabled."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Linux.Enabled}" OnContent="Enabled" OffContent="Disabled"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Launcher" Requirement="Required" Description="The launcher, emulator, or compatibility method used on Linux."><local:LabeledField.FieldContent><ComboBox ItemsSource="{Binding LauncherKinds}" SelectedItem="{Binding Configuration.Launch.Linux.Launcher}" ItemTemplate="{StaticResource LauncherKindTemplate}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid ColumnDefinitions="*,Auto,8,Auto"><TextBlock Text="{Binding LinuxLauncherStatus}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Verify selected launcher" Tag="linux" Click="VerifySelectedLauncherClicked"/><Button Grid.Column="3" Content="Locate launcher folder" Tag="linux" Click="LocateLauncherFolderClicked"/></Grid></Border>
          <local:LabeledField Label="Steam App ID" Description="Needed for Steam, or for Proton when launching through Steam."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.SteamId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Heroic game ID" Description="Needed for Heroic Games Launcher unless a custom URI is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.HeroicGameId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Flatpak app ID" Description="Needed for a Flatpak app unless an executable command is supplied."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.FlatpakAppId}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#102419" BorderBrush="#347A4D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,8,0,14"><TextBlock Text="{Binding PathStatus}" Foreground="#AEEBC3" TextWrapping="Wrap"/></Border>
          <local:LabeledField Label="Executable" Description="Required for EXE, Emulator, or Wine. Locate saves a portable path without a mount location."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto,8,Auto"><TextBox Text="{Binding Configuration.Launch.Linux.Executable}"/><Button Grid.Column="2" Content="Locate game" Tag="linux-game" Click="LocatePortableFileClicked"/><Button Grid.Column="4" Content="Locate emulator" Tag="linux-emulator" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Arguments" Description="Optional. Extra command-line options. Locate ROM appends a safely quoted portable game-image path."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Launch.Linux.Arguments}"/><Button Grid.Column="2" Content="Locate ROM" Tag="linux-rom" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Working directory" Description="Optional. Folder the game should treat as its starting location."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.WorkingDirectory}"/></local:LabeledField.FieldContent></local:LabeledField>
          <Border Background="#101923" BorderBrush="#31506E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,12">
            <StackPanel Spacing="7">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Linux emulator command-line quick reference"/>
              <TextBlock Classes="help" Text="Choose Emulator as the launcher. Native executables and AppImages can use the same game arguments as Windows; RetroArch cores normally end in .so."/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="RetroArch    -f -L &quot;../../Emulators/RetroArch/cores/core_libretro.so&quot; &quot;Game/Game.rom&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="DuckStation  -batch -fullscreen -- &quot;Game/Game.cue&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="PCSX2        -fullscreen -batch -- &quot;Game/Game.iso&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="Dolphin      -b -e &quot;Game/Game.rvz&quot;  (enable Start in Fullscreen in Dolphin)" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="RPCS3        --no-gui --fullscreen &quot;Game/Game/PS3_GAME/USRDIR/EBOOT.BIN&quot;" TextWrapping="Wrap"/>
              <TextBlock FontFamily="Cascadia Mono,Consolas" FontSize="12" Text="PPSSPP       --fullscreen --pause-menu-exit &quot;Game/Game.iso&quot;" TextWrapping="Wrap"/>
              <TextBlock Classes="help" Text="Make native binaries and AppImages executable before launching. AppImage process names can vary, so verify the running process once."/>
            </StackPanel>
          </Border>
          <TextBlock FontWeight="SemiBold" FontSize="16" Margin="0,18,0,14" Text="Companion executable"/>
          <TextBlock Classes="help" Margin="0,0,0,14" Text="Optional. Start a native Linux helper immediately before the primary executable or launcher."/>
          <local:LabeledField Label="Launch companion app" Description="Optional. Enable this only when another program must start before the game."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Linux.CompanionApplication.Enabled}" OnContent="Enabled" OffContent="Disabled"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion executable" Description="Required when enabled. Locate a native helper stored on the cart."><local:LabeledField.FieldContent><Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding Configuration.Launch.Linux.CompanionApplication.Executable}" PlaceholderText="Example: Tools/controller-helper"/><Button Grid.Column="2" Content="Locate companion" Tag="linux-companion" Click="LocatePortableFileClicked"/></Grid></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion arguments" Description="Optional. Command-line options passed only to the companion app."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.CompanionApplication.Arguments}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Companion working directory" Description="Optional. Leave blank to use the game folder."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.CompanionApplication.WorkingDirectory}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Close companion after game" Description="Optional. Automatically closes the companion when the game exits."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Launch.Linux.CompanionApplication.CloseAfterGame}" OnContent="Close automatically" OffContent="Leave running"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Process name" Description="Optional. Helps detect when the game starts and exits."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.ProcessName}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Launch URI" Description="Optional. A custom launcher address that can replace an ID where supported."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.Uri}"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Proton or Wine executable/version" Requirement="Advanced" Description="For a direct Proton or Wine launch, choose or enter the executable/path for the desired build, such as Proton Experimental or GE-Proton. For a Steam App ID, Steam’s per-game Compatibility setting selects the Proton version."><local:LabeledField.FieldContent><ComboBox IsEditable="True" ItemsSource="{Binding ProtonSuggestions}" Text="{Binding Configuration.Launch.Linux.CompatibilityTool}" PlaceholderText="Leave blank to use the default"/></local:LabeledField.FieldContent></local:LabeledField>
          <local:LabeledField Label="Wine or Proton prefix" Requirement="Advanced" Description="Optional. Path to this game’s compatibility environment. For Steam-managed Proton games, Steam normally creates and manages this automatically."><local:LabeledField.FieldContent><TextBox Text="{Binding Configuration.Launch.Linux.WinePrefix}"/></local:LabeledField.FieldContent></local:LabeledField>
        </StackPanel></Border></StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="5  Series collection">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900" Spacing="16">
          <Border Classes="card"><Grid ColumnDefinitions="380,24,*">
            <Border Width="360" Height="112" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#080A0D" BorderBrush="#3A4451" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
              <Grid>
                <TextBlock Text="COLLECTION HEADER LOGO" Foreground="#657080" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasCollectionLogoPreview}"/>
                <Image Source="{Binding CollectionLogoPreview}" Stretch="Uniform"
                       IsVisible="{Binding HasCollectionLogoPreview}"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="section" Text="Collection header logo"/>
              <TextBlock Text="Recommended: 1440 × 448 px transparent PNG" FontWeight="SemiBold"/>
              <TextBlock Classes="help" Text="Displayed at 360 × 112. Keep important artwork inside the centered 1320 × 360 safe area so edges remain comfortable at every supported resolution." TextWrapping="Wrap"/>
              <TextBlock Text="{Binding CollectionLogoStatus}" Foreground="#AAB2BE" TextWrapping="Wrap"/>
              <Button Content="Choose and add collection logo" Click="ChooseCollectionLogoClicked" HorizontalAlignment="Left"/>
            </StackPanel>
          </Grid></Border>
          <Border Classes="card"><StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel><TextBlock Classes="section" Text="Collection shelf organizer"/><TextBlock Classes="help" Text="Choose a shelf for each primary game and use the arrows to set its position. Alternate platform versions remain grouped behind the primary shelf card."/></StackPanel>
              <Button Grid.Column="1" Content="Save collection layout" Click="SaveCollectionLayoutClicked"/>
            </Grid>
            <Grid ColumnDefinitions="*,10,Auto"><TextBox Text="{Binding NewShelfName}" PlaceholderText="New shelf name, such as The 3D Era"/><Button Grid.Column="2" Content="Add shelf" Click="AddCollectionShelfClicked"/></Grid>
            <TextBlock Text="{Binding CollectionLayoutStatus}" Foreground="#AAB2BE" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding CollectionShelves}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#11171E" BorderBrush="#37414D" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,44,6,44,10,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="↑" Tag="up" Click="MoveCollectionShelfClicked"/>
                    <Button Grid.Column="3" Content="↓" Tag="down" Click="MoveCollectionShelfClicked"/>
                    <Button Grid.Column="5" Content="Remove shelf" Click="RemoveCollectionShelfClicked"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#151B23" BorderBrush="#485361" BorderThickness="1" CornerRadius="9" Padding="14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="64,*,240,100" Margin="4,0,4,2">
                  <TextBlock Grid.Column="1" Text="Primary shelf game" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="2" Text="Shelf" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="3" Text="Order" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding CollectionGames}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Background="#0D1117" BorderBrush="#313A46" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                      <Grid ColumnDefinitions="52,12,*,16,240,16,44,6,44">
                        <Border Width="52" Height="72" Background="#080A0D" CornerRadius="4" ClipToBounds="True"><Grid><Image Source="{Binding CoverPreview}" Stretch="UniformToFill" IsVisible="{Binding HasCoverPreview}"/><TextBlock Text="?" Foreground="#6E7783" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasCoverPreview}"/></Grid></Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding PlatformLabel}" Foreground="#8E98A6" FontSize="12"/></StackPanel>
                        <ComboBox Grid.Column="4" ItemsSource="{Binding $parent[Window].DataContext.CollectionShelfChoices}" SelectedItem="{Binding Shelf}"/>
                        <Button Grid.Column="6" Content="↑" Tag="up" Click="MoveCollectionGameClicked"/>
                        <Button Grid.Column="8" Content="↓" Tag="down" Click="MoveCollectionGameClicked"/>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel Spacing="9">
            <TextBlock Classes="section" Text="How the collection launcher works"/>
            <TextBlock Classes="help" Text="Config/collection.json turns Custom Series Collection mode on and defines the collection name, transparent logo, accent color, and shelf order."/>
            <TextBlock Text="• Only shelves containing games are displayed." TextWrapping="Wrap"/>
            <TextBlock Text="• Shelf names must match exactly between collection.json and this game." TextWrapping="Wrap"/>
            <TextBlock Text="• Games without a shelf use defaultShelf; leave defaultShelf blank for an unnamed fallback row." TextWrapping="Wrap"/>
            <TextBlock Text="• Collection logos use a portable path such as Assets/Collections/MySeries/Logo.png." TextWrapping="Wrap"/>
            <TextBlock Classes="help" Margin="0,8,0,0" Text="Start from Config/collection.example.json. Restart the launcher or press F5 after changing collection placement."/>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="6  Behavior">
        <ScrollViewer><StackPanel Margin="12" MaxWidth="900" Spacing="16">
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Platform preference"/><TextBlock Classes="help" Margin="0,4,0,20" Text="Automatic is recommended and selects the matching configuration for the current computer."/>
            <local:LabeledField Label="Preferred platform" Description="Usually leave this on Automatic. Force Windows or Linux only for a special setup."><local:LabeledField.FieldContent><ComboBox ItemsSource="{Binding PreferredPlatforms}" SelectedItem="{Binding Configuration.Launch.PreferredPlatform}"/></local:LabeledField.FieldContent></local:LabeledField>
          </StackPanel></Border>
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="While a game is running"/>
            <local:LabeledField Label="Hide the launcher" Description="Recommended. Hides Cart Launch Companion after the game starts."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Behavior.HideWhileGameRuns}" OnContent="Hide" OffContent="Keep visible"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Restore after exit" Description="Recommended. Brings Cart Launch Companion back when the game closes."><local:LabeledField.FieldContent><ToggleSwitch IsChecked="{Binding Configuration.Behavior.RestoreLauncherAfterExit}" OnContent="Restore" OffContent="Stay hidden"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Start timeout (seconds)" Requirement="Advanced" Description="How long to wait for the game process to appear. Valid range: 1–3600."><local:LabeledField.FieldContent><NumericUpDown Value="{Binding Configuration.Behavior.ProcessStartTimeoutSeconds}" Minimum="1" Maximum="3600"/></local:LabeledField.FieldContent></local:LabeledField>
            <local:LabeledField Label="Exit check interval (seconds)" Requirement="Advanced" Description="How often to check whether the game has closed. Valid range: 1–60."><local:LabeledField.FieldContent><NumericUpDown Value="{Binding Configuration.Behavior.ProcessExitPollSeconds}" Minimum="1" Maximum="60"/></local:LabeledField.FieldContent></local:LabeledField>
          </StackPanel></Border>
        </StackPanel></ScrollViewer>
      </TabItem>

      <TabItem Header="7  Review &amp; save">
        <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="14">
          <Border Classes="card"><StackPanel>
            <TextBlock Classes="section" Text="Check before saving"/>
            <TextBlock Classes="help" Margin="0,5,0,12" Text="Validation checks the same rules used by Cart Launch Companion. Missing game executables are allowed; they simply will not launch until installed."/>
            <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Validate configuration" Click="ValidateClicked"/><Button Content="Refresh JSON preview" Click="PreviewClicked"/></StackPanel>
          </StackPanel></Border>
          <Border Grid.Row="1" Classes="card">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="section" Text="Artwork sanity check"/>
                  <TextBlock Classes="help" Text="Checks every saved game’s cover, background, logo, and icon using the same paths as the launcher."/>
                </StackPanel>
                <Button Grid.Column="1" Content="Run artwork check" Click="AuditArtworkClicked"/>
              </Grid>
              <TextBlock Grid.Row="1" Text="{Binding ArtworkAuditSummary}" FontWeight="SemiBold"/>
              <ListBox Grid.Row="2" ItemsSource="{Binding ArtworkAuditResults}" MaxHeight="210">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="34,220,130,*" Margin="4,3">
                      <TextBlock Text="{Binding Symbol}" Foreground="{Binding StatusColor}" FontSize="18" FontWeight="Bold"/>
                      <TextBlock Grid.Column="1" Text="{Binding Game}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Asset}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#AAB2BE"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <Border Grid.Row="2" Classes="card"><Grid RowDefinitions="Auto,*">
            <TextBlock Classes="section" Text="game.json preview"/>
            <TextBox Grid.Row="1" Margin="0,14,0,0" Text="{Binding JsonPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas" FontSize="12"/>
          </Grid></Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#10141A" BorderBrush="#2A313B" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Classes="help" Text="Required = needed to save a working configuration  •  Optional = improves presentation or detection  •  Advanced = safe to leave at its default"/></StackPanel>
        <Button Grid.Column="1" Background="#2F80ED" Foreground="White" FontWeight="SemiBold" Content="Validate and save game.json" Click="SaveClicked" MinWidth="230"/>
      </Grid>
    </Border>
  </Grid>
</Window>
