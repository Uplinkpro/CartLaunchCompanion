<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CartLaunchCompanion.Configurator.RetroArchCoreDownloadDialog"
        Title="Install required RetroArch core" Width="700" Height="410"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="28">
    <StackPanel Spacing="12">
      <TextBlock FontSize="25" FontWeight="Bold" Text="This game needs a RetroArch core"/>
      <TextBlock x:Name="ExplanationText" Classes="help" TextWrapping="Wrap"/>
      <TextBlock FontWeight="SemiBold" Text="Compatible core" Margin="0,8,0,0"/>
      <ComboBox x:Name="CoreBox" MinHeight="44" SelectionChanged="CoreSelectionChanged"/>
      <Border Background="#20242A" CornerRadius="8" Padding="14" Margin="0,8,0,0">
        <StackPanel Spacing="7">
          <TextBlock Text="Official download" FontWeight="SemiBold"/>
          <TextBlock x:Name="SourceText" Classes="help" TextWrapping="Wrap"/>
          <TextBlock Text="Install destination" FontWeight="SemiBold" Margin="0,5,0,0"/>
          <TextBlock x:Name="DestinationText" Classes="help" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <TextBlock x:Name="StatusText" Classes="help" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="CancelButton" Content="Cancel" Click="CancelClicked"/>
      <Button x:Name="DownloadButton" Content="Download, apply, and save core" Click="DownloadClicked"/>
    </StackPanel>
  </Grid>
</Window>
