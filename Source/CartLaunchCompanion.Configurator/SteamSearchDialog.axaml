<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CartLaunchCompanion.Configurator.SteamSearchDialog"
        Title="Find game on Steam" Width="720" Height="620" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" CanResize="True">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <StackPanel>
      <TextBlock FontSize="24" FontWeight="Bold" Text="Find the right Steam game"/>
      <TextBlock Classes="help" Text="Search by game title or enter an exact Steam App ID. Nothing is changed until you select a result."/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,12,Auto">
      <TextBox x:Name="SearchBox" PlaceholderText="Game name or Steam App ID" KeyDown="SearchKeyDown"/>
      <Button Grid.Column="2" Content="Search Steam" Click="SearchClicked"/>
    </Grid>
    <Border Grid.Row="2" Classes="card">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="StatusText" Foreground="#AAB2BE" Text="Enter a game name to begin."/>
        <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="ResultSelected">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="120,16,*" Margin="4,7">
                <Border Width="120" Height="56" Background="#090B0E" CornerRadius="4" ClipToBounds="True">
                  <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="help" Text="{Binding SourceText}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="LegacyIdPanel" Grid.Row="2" IsVisible="False" Background="#2A2418" BorderBrush="#66522C" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,10,0,0">
          <Grid ColumnDefinitions="*,12,220">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Historical Steam App ID required"/>
              <TextBlock Classes="help" Text="This delisted SteamGridDB match is not in Steam’s current catalog. Enter its known App ID to continue."/>
            </StackPanel>
            <TextBox x:Name="LegacyAppIdBox" Grid.Column="2" PlaceholderText="Example: 12170" TextChanged="LegacyAppIdChanged"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,10,Auto">
      <TextBlock VerticalAlignment="Center" Foreground="#AAB2BE" Text="The first search can take a little longer while Steam’s catalog is cached."/>
      <Button Grid.Column="1" Content="Cancel" Click="CancelClicked"/>
      <Button x:Name="UseButton" Grid.Column="3" Content="Use selected game" IsEnabled="False" Background="#2F80ED" Foreground="White" Click="UseClicked"/>
    </Grid>
  </Grid>
</Window>
