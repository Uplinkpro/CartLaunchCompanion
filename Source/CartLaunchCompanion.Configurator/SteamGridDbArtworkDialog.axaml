<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CartLaunchCompanion.Configurator.SteamGridDbArtworkDialog" Title="Choose SteamGridDB artwork"
        Width="980" Height="720" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <StackPanel><TextBlock FontSize="24" FontWeight="Bold" Text="Choose community artwork"/><TextBlock Classes="help" Text="Static, non-adult, non-humor, and non-epilepsy-tagged artwork is shown by default. Higher-quality and community-rated results appear first."/></StackPanel>
    <TabControl x:Name="KindTabs" Grid.Row="1" SelectionChanged="KindChanged"><TabItem Header="Cover"/><TabItem Header="Hero"/><TabItem Header="Logo"/><TabItem Header="Icon"/></TabControl>
    <Border Grid.Row="2" Classes="card"><Grid RowDefinitions="Auto,*"><TextBlock x:Name="StatusText" Foreground="#AAB2BE"/><ListBox x:Name="AssetsList" Grid.Row="1" Margin="0,12,0,0" SelectionChanged="AssetSelected"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="200" Margin="6" Background="#090B0E" CornerRadius="7" Padding="8"><StackPanel Spacing="7"><Border Height="120" Background="#050608"><Image Source="{Binding Preview}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Credit}" Classes="help"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,10,Auto"><TextBlock VerticalAlignment="Center" Classes="help" Text="The selected full-resolution file will be downloaded and validated before replacing existing artwork."/><Button Grid.Column="1" Content="Cancel" Click="CancelClicked"/><Button x:Name="UseButton" Grid.Column="3" Content="Use selected artwork" IsEnabled="False" Click="UseClicked" Background="#2F80ED" Foreground="White"/></Grid>
  </Grid>
</Window>
