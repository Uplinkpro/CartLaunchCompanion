<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CartLaunchCompanion.EmulatorCompanion"
        x:Class="CartLaunchCompanion.EmulatorCompanion.UninstallWindow"
        x:DataType="local:UninstallViewModel"
        Title="{Binding Title}" Icon="/Assets/AppIcon.png"
        Width="560" Height="470" MinWidth="480" MinHeight="400"
        WindowState="FullScreen"
        WindowStartupLocation="CenterOwner">
  <Border Classes="shell">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="releaseContent">
      <StackPanel Classes="intro">
        <TextBlock Classes="eyebrow" Text="MANAGED UNINSTALL" />
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="help" Text="Choose which installed build to remove." />
      </StackPanel>
      <StackPanel Classes="platformChoices">
        <RadioButton GroupName="UninstallPlatform" Content="Windows x64" IsVisible="{Binding ShowWindows}"
                     IsChecked="{Binding IsWindowsSelected, Mode=TwoWay}" />
        <RadioButton GroupName="UninstallPlatform" Content="Linux x64" IsVisible="{Binding ShowLinux}"
                     IsChecked="{Binding IsLinuxSelected, Mode=TwoWay}" />
        <RadioButton GroupName="UninstallPlatform" Content="Both installed builds" IsVisible="{Binding ShowBoth}"
                     IsChecked="{Binding IsBothSelected, Mode=TwoWay}" />
      </StackPanel>
      <Border Classes="nextStepCard">
        <StackPanel Classes="intro">
          <CheckBox Content="Keep settings, firmware, saves, and controller data"
                    IsChecked="{Binding PreservePersonalData, Mode=TwoWay}" />
          <TextBlock Classes="help" Text="Kept data is restored automatically if you install this emulator again. ROM folders are always preserved." />
        </StackPanel>
      </Border>
      <TextBlock Classes="help" Text="{Binding Message}" />
      <Border Classes="workflowCard" IsVisible="{Binding HasActivity}">
        <StackPanel Classes="intro">
          <TextBlock Classes="eyebrow" Text="UNINSTALL ACTIVITY" />
          <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ProgressBar IsIndeterminate="True" Height="8" IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="secondary" Content="Cancel" Click="CancelClicked" IsVisible="{Binding ShowUninstallAction}" />
        <Button Classes="danger" Content="Uninstall selected builds" IsEnabled="{Binding CanUninstall}"
                IsVisible="{Binding ShowUninstallAction}" Click="UninstallClicked" />
        <Button Classes="primary" Content="Return home" IsVisible="{Binding Completed}" Click="ReturnHomeClicked" />
      </StackPanel>
    </StackPanel>
    </ScrollViewer>
  </Border>
</Window>
