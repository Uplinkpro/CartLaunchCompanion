<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartLaunchCompanion.Desktop.ViewModels"
             xmlns:controls="using:CartLaunchCompanion.Desktop.Controls"
             x:Class="CartLaunchCompanion.Desktop.Views.MetadataView"
             x:DataType="vm:MainViewModel"
             Focusable="True">
    <Grid Background="Transparent"
          Focusable="True">
        <controls:StudioRenderer />

        <Image Source="{Binding SelectedGame.BackgroundImage}"
               Stretch="UniformToFill"
               IsVisible="{Binding SelectedGame.HasBackground}" />
        <Image Source="{Binding SelectedGame.HeroImage}"
               Stretch="Uniform"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Top"
               IsVisible="{Binding SelectedGame.HasHeroOnly}" />

        <!-- This contrast field keeps overlaid copy readable across changing artwork. -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#B8000000" Offset="0" />
                    <GradientStop Color="#78000000" Offset="0.38" />
                    <GradientStop Color="#12000000" Offset="0.72" />
                    <GradientStop Color="#42000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="3*,Auto,2*">
            <Grid Grid.Row="0"
                  Classes="metadata-content"
                  ColumnDefinitions="3*,*"
                  ColumnSpacing="28">
                <Grid Grid.Column="0"
                      RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="10"
                      MaxWidth="720"
                      HorizontalAlignment="Left">
                    <Image Grid.Row="0"
                           Classes="metadata-logo"
                           Source="{Binding SelectedGame.LogoImage}"
                           IsVisible="{Binding SelectedGame.HasLogo}" />
                    <TextBlock Grid.Row="0"
                               Classes="metadata-game-title"
                               Text="{Binding SelectedGame.Name}"
                               IsVisible="{Binding SelectedGame.HasNoLogo}" />

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="4">
                        <TextBlock Grid.Row="0" Text="Developer:" Classes="metadata-field-label" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SelectedGame.DeveloperDisplay}"
                                   Classes="metadata-field-value" />
                        <TextBlock Grid.Row="1" Text="Publisher:" Classes="metadata-field-label" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding SelectedGame.PublisherDisplay}"
                                   Classes="metadata-field-value" />
                        <TextBlock Grid.Row="2" Text="Platform:" Classes="metadata-field-label" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding SelectedGame.PlatformDisplay}"
                                   Classes="metadata-field-value" />
                    </Grid>

                    <ScrollViewer x:Name="DescriptionScroller"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding SelectedGame.DescriptionDisplay}"
                                   Classes="metadata-description"
                                   MaxWidth="600" />
                    </ScrollViewer>

                    <WrapPanel Grid.Row="3" Orientation="Horizontal">
                        <Border Classes="metadata-capability"
                                BorderBrush="{Binding SelectedGame.AccentBrightColor}">
                            <Grid>
                                <Image Source="{Binding SelectedGame.LauncherLogoImage}"
                                       Stretch="Uniform"
                                       IsVisible="{Binding SelectedGame.UsesLauncherBranding}" />
                                <TextBlock Text="CLC"
                                           Classes="metadata-capability-text"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding SelectedGame.UsesCartLaunchBranding}" />
                            </Grid>
                        </Border>

                        <Border Classes="metadata-capability"
                                BorderBrush="{Binding SelectedGame.SteamDeckCompatibilityColor}"
                                IsVisible="{Binding SelectedGame.HasSteamDeckCompatibility}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="{Binding SelectedGame.SteamDeckCompatibilityGlyph}"
                                           Foreground="{Binding SelectedGame.SteamDeckCompatibilityColor}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedGame.SteamDeckCompatibilityText}"
                                           Classes="metadata-capability-text"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Classes="metadata-capability"
                                BorderBrush="{Binding SelectedGame.GamepadSupportColor}"
                                IsVisible="{Binding SelectedGame.HasGamepadSupport}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Width="28" Height="20" Stretch="Uniform">
                                    <Canvas Width="58" Height="42">
                                        <Path Data="M9,7 Q13,3 19,4 L21,6 H37 L39,4 Q45,3 49,7 Q53,12 55,21 L57,31 Q58,37 53,40 L47,42 L39,34 Q37,32 34,32 H24 Q21,32 19,34 L11,42 L5,40 Q0,37 1,31 L3,21 Q5,12 9,7 Z"
                                              Stroke="{Binding SelectedGame.GamepadSupportColor}"
                                              StrokeThickness="2.4"
                                              Fill="Transparent" />
                                        <Path Data="M14,13 L14,21 M10,17 L18,17"
                                              Stroke="{Binding SelectedGame.GamepadSupportColor}"
                                              StrokeThickness="2" />
                                        <Ellipse Canvas.Left="20" Canvas.Top="23" Width="7" Height="7"
                                                 Stroke="{Binding SelectedGame.GamepadSupportColor}"
                                                 StrokeThickness="1.8" />
                                        <Ellipse Canvas.Left="34" Canvas.Top="23" Width="7" Height="7"
                                                 Stroke="{Binding SelectedGame.GamepadSupportColor}"
                                                 StrokeThickness="1.8" />
                                        <Ellipse Canvas.Left="43" Canvas.Top="12" Width="4" Height="4"
                                                 Fill="{Binding SelectedGame.GamepadSupportColor}" />
                                        <Ellipse Canvas.Left="48" Canvas.Top="17" Width="4" Height="4"
                                                 Fill="{Binding SelectedGame.GamepadSupportColor}" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding SelectedGame.GamepadSupportText}"
                                           Classes="metadata-capability-text"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12">
                        <Button Classes="metadata-action metadata-play"
                                Command="{Binding ConfirmLaunchCommand}"
                                AutomationProperties.Name="Launch selected game"
                                Content="Play" />
                        <Button Classes="metadata-action metadata-back"
                                Command="{Binding ReturnHomeCommand}"
                                AutomationProperties.Name="Return to game library"
                                Content="Back" />
                    </StackPanel>
                </Grid>

                <!-- Intrinsic 2:3 cover art plus its platform banner scales as one unit. -->
                <Viewbox Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Stretch"
                         Stretch="Uniform">
                    <Grid Width="210" Height="350" RowDefinitions="35,315">
                        <Border Grid.Row="0"
                                Background="{Binding SelectedGame.AccentColor}"
                                IsVisible="{Binding SelectedGame.HasNoLauncherBanner}">
                            <TextBlock Text="{Binding SelectedGame.PlatformDisplay}"
                                       Classes="metadata-capability-text"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Image Grid.Row="0"
                               Source="{Binding SelectedGame.LauncherBannerImage}"
                               Stretch="Fill"
                               IsVisible="{Binding SelectedGame.HasLauncherBanner}" />
                        <Border Grid.Row="1" Classes="metadata-cover-frame">
                            <Grid>
                                <Image Source="{Binding SelectedGame.CoverImage}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding SelectedGame.HasCover}" />
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            IsVisible="{Binding SelectedGame.HasNoCover}">
                                    <TextBlock Text="{Binding SelectedGame.Initials}"
                                               Classes="metadata-game-title"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="COVER ART MISSING"
                                               Classes="metadata-panel-muted" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>

            <Border Grid.Row="1" Classes="metadata-status-strip">
                <ItemsControl ItemsSource="{Binding MetadataModules}"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetadataModuleViewModel">
                            <Border Classes="metadata-status-item">
                                <Grid ColumnDefinitions="38,Auto" ColumnSpacing="10">
                                    <Grid Width="32" Height="32"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                        <Path Data="M3,3 L8,3 L8,21 L3,21 Z M10,3 L15,3 L15,21 L10,21 Z M17,4 L20,3 L23,20 L20,21 Z"
                                              Classes="metadata-module-icon"
                                              IsVisible="{Binding IsLibrary}" />
                                        <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21"
                                              Classes="metadata-module-icon"
                                              IsVisible="{Binding IsPlatform}" />
                                        <Path Data="M4,3 L6,3 L6,1 L8,1 L8,3 L16,3 L16,1 L18,1 L18,3 L20,3 L20,21 L4,21 Z M6,8 L18,8 M7,11 L10,11 L10,14 L7,14 Z"
                                              Classes="metadata-module-icon"
                                              IsVisible="{Binding IsLastPlayed}" />
                                        <Path Data="M12,2 A10,10 0 1 1 11.99,2 M12,6 L12,12 L17,15"
                                              Classes="metadata-module-icon"
                                              IsVisible="{Binding IsTimePlayed}" />
                                        <Path Data="M12,2 L15,8 L22,9 L17,14 L18,21 L12,18 L6,21 L7,14 L2,9 L9,8 Z"
                                              Classes="metadata-module-icon"
                                              IsVisible="{Binding IsAchievements}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" Classes="metadata-status-label" />
                                        <TextBlock Text="{Binding Value}" Classes="metadata-status-value" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Row="2"
                    Background="{DynamicResource MetadataLowerSectionBrush}" />

            <Grid Grid.Row="2"
                  Margin="12"
                  ColumnDefinitions="1.35*,0.9*,1.1*"
                  ColumnSpacing="12">
                <Border Grid.Column="0"
                        Classes="metadata-lower-panel"
                        IsVisible="{Binding HasAchievementData}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Achievements" Classes="metadata-panel-title" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding RetroAchievementsAward}"
                                       Classes="metadata-status-value"
                                       IsVisible="{Binding IsRetroAchievementsVisible}" />
                            <TextBlock Grid.Column="1"
                                       Text="STEAM"
                                       Classes="metadata-status-value"
                                       IsVisible="{Binding IsSteamAchievementsVisible}" />
                            <TextBlock Grid.Column="1"
                                       Text="EXOPHASE"
                                       Classes="metadata-status-value"
                                       IsVisible="{Binding IsExophaseAchievementsVisible}" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5"
                              IsVisible="{Binding IsExophaseAchievementsVisible}">
                            <TextBlock Text="{Binding ExophaseAchievementsProgress}"
                                       Classes="metadata-panel-muted" />
                            <ProgressBar Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ExophaseAchievementsPercent}"
                                         Classes="metadata-achievement-progress" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5"
                              IsVisible="{Binding IsSteamAchievementsVisible}">
                            <TextBlock Text="{Binding SteamAchievementsProgress}"
                                       Classes="metadata-panel-muted" />
                            <ProgressBar Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding SteamAchievementsPercent}"
                                         Classes="metadata-achievement-progress" />
                        </Grid>

                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5"
                              IsVisible="{Binding IsRetroAchievementsVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding RetroAchievementsProgress}"
                                           Classes="metadata-panel-muted" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RetroAchievementsPoints}"
                                           Classes="metadata-status-value" />
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding RetroAchievementsPercent}"
                                         Classes="metadata-achievement-progress"
                                         IsIndeterminate="{Binding IsRetroAchievementsLoading}" />
                        </Grid>

                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding RetroAchievementsRecent}"
                                      IsVisible="{Binding HasRetroAchievementsRecent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RetroAchievementItemViewModel">
                                    <Grid Classes="metadata-achievement-badge"
                                          ColumnDefinitions="40,*"
                                          ColumnSpacing="8">
                                        <Border Classes="metadata-achievement-image">
                                            <Grid>
                                                <Image Source="{Binding BadgeImage}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding HasBadge}" />
                                                <TextBlock Text="★"
                                                           Classes="metadata-status-value"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !HasBadge}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Classes="metadata-achievement-title"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       Classes="metadata-achievement-detail"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding PointsText}"
                                                       Classes="metadata-achievement-detail" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding RetroAchievementsStatus}"
                                   Classes="metadata-panel-muted"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding !HasRetroAchievementsRecent}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="metadata-media-frame">
                    <Grid>
                        <Image Source="{Binding SelectedGame.IconImage}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SelectedGame.HasIcon}" />
                        <Grid IsVisible="{Binding SelectedGame.HasNoIcon}">
                            <Image Source="{Binding SelectedGame.BackgroundImage}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding SelectedGame.HasBackground}" />
                            <Image Source="{Binding SelectedGame.HeroImage}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding SelectedGame.HasHeroOnly}" />
                            <Image Source="{Binding SelectedGame.LogoImage}"
                                   Stretch="Uniform"
                                   Margin="24"
                                   IsVisible="{Binding SelectedGame.HasLogo}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Classes="metadata-media-frame metadata-trailer-frame">
                    <Grid>
                        <Image Source="{Binding SelectedGame.CurrentScreenshotImage}"
                               Stretch="Uniform"
                               IsVisible="{Binding SelectedGame.HasScreenshots}" />
                        <controls:VlcNativeTrailerControl x:Name="TrailerPlayer"
                                                          Source="{Binding SelectedGame.TrailerSource}"
                                                          IsActive="{Binding ShouldPlayTrailer}"
                                                          IsVisible="{Binding SelectedGame.HasTrailerSource}"
                                                          ZIndex="5" />
                        <Border Background="{DynamicResource MetadataSurfaceStrongBrush}"
                                ZIndex="6"
                                IsVisible="{Binding #TrailerPlayer.PlaybackFailed}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="5">
                                <TextBlock Text="TRAILER UNAVAILABLE"
                                           Classes="metadata-trailer-error-title" />
                                <TextBlock Text="Showing screenshots instead"
                                           Classes="metadata-panel-muted" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedGame.ScreenshotIndicators}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,8"
                                      ZIndex="7">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScreenshotIndicatorViewModel">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Fill}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
