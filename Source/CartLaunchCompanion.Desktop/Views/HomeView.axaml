<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartLaunchCompanion.Desktop.ViewModels"
             xmlns:controls="using:CartLaunchCompanion.Desktop.Controls"
             x:Class="CartLaunchCompanion.Desktop.Views.HomeView"
             x:DataType="vm:MainViewModel"
             Classes.motion="{Binding UseMotionEffects}"
             Focusable="True">

    <UserControl.Styles>
        <Style Selector="Border.selection-title-pulse">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="UserControl.motion Border.selection-title-pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.15"
                           IterationCount="Infinite"
                           PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.18" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.selection-card-accent">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.selection-card-pulse">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.game-card.selected Border.selection-card-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.game-card.selected Border.selection-card-pulse">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.game-card:pointerover Border.selection-card-accent">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.game-card:pointerover Border.selection-card-pulse">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Border.controller-indicator">
            <Setter Property="Opacity" Value="0.30" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.controller-indicator.connected">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.controller-indicator Path">
            <Setter Property="Stroke" Value="#A8B3BD" />
        </Style>
        <Style Selector="Border.controller-indicator.connected Path">
            <Setter Property="Stroke" Value="#62EF75" />
        </Style>
        <Style Selector="Border.controller-indicator Ellipse">
            <Setter Property="Fill" Value="#A8B3BD" />
            <Setter Property="Stroke" Value="#A8B3BD" />
        </Style>
        <Style Selector="Border.controller-indicator.connected Ellipse">
            <Setter Property="Fill" Value="#62EF75" />
            <Setter Property="Stroke" Value="#62EF75" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#030406">
        <!-- A seamless frosted atmosphere inherited from the selected game. -->
        <Image Source="{Binding SelectedGame.BackgroundImage}"
               IsVisible="{Binding IsHomeVisible}"
               Stretch="UniformToFill"
               Opacity="0.30"
               Margin="-34">
            <Image.Effect>
                <BlurEffect Radius="5" />
            </Image.Effect>
        </Image>
        <Image Source="{Binding SelectedGame.HeroImage}"
               IsVisible="{Binding SelectedGame.HasHeroOnly}"
               Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Opacity="0.82">
            <Image.Effect><BlurEffect Radius="5" /></Image.Effect>
            <Image.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#FFFFFFFF" Offset="0.00" />
                    <GradientStop Color="#FFFFFFFF" Offset="0.50" />
                    <GradientStop Color="#FAFFFFFF" Offset="0.58" />
                    <GradientStop Color="#E8FFFFFF" Offset="0.65" />
                    <GradientStop Color="#C8FFFFFF" Offset="0.72" />
                    <GradientStop Color="#98FFFFFF" Offset="0.79" />
                    <GradientStop Color="#60FFFFFF" Offset="0.86" />
                    <GradientStop Color="#30FFFFFF" Offset="0.92" />
                    <GradientStop Color="#10FFFFFF" Offset="0.97" />
                    <GradientStop Color="#00FFFFFF" Offset="1.00" />
                </LinearGradientBrush>
            </Image.OpacityMask>
        </Image>
        <Border Background="#08080B10" />
        <Border IsVisible="{Binding IsHomeVisible}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00000000" Offset="0.000" />
                    <GradientStop Color="#00000000" Offset="0.053" />
                    <GradientStop Color="#00000000" Offset="0.105" />
                    <GradientStop Color="#00000000" Offset="0.158" />
                    <GradientStop Color="#00000000" Offset="0.211" />
                    <GradientStop Color="#00000000" Offset="0.263" />
                    <GradientStop Color="#00000000" Offset="0.316" />
                    <GradientStop Color="#08000000" Offset="0.368" />
                    <GradientStop Color="#12000000" Offset="0.421" />
                    <GradientStop Color="#20000000" Offset="0.474" />
                    <GradientStop Color="#32000000" Offset="0.526" />
                    <GradientStop Color="#48000000" Offset="0.579" />
                    <GradientStop Color="#62000000" Offset="0.632" />
                    <GradientStop Color="#7E000000" Offset="0.684" />
                    <GradientStop Color="#9A000000" Offset="0.737" />
                    <GradientStop Color="#B6000000" Offset="0.789" />
                    <GradientStop Color="#D0000000" Offset="0.842" />
                    <GradientStop Color="#E6000000" Offset="0.895" />
                    <GradientStop Color="#F6000000" Offset="0.947" />
                    <GradientStop Color="#FF000000" Offset="1.000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Home: browse only. -->
        <Grid IsVisible="{Binding IsHomeVisible}"
              Classes="page-transition"
              Classes.active="{Binding IsHomeVisible}"
              Classes.motion="{Binding UseMotionEffects}"
              RowDefinitions="*,Auto"
              Margin="32">

            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  ZIndex="20"
                  Width="190"
                  Height="176"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Margin="6,4,0,0">
                <StackPanel HorizontalAlignment="Left"
                            Spacing="4"
                            IsVisible="{Binding ShowCartLaunchBranding}">
                <Border Width="74"
                        Height="60"
                        CornerRadius="10"
                        BorderBrush="#DDE5E8F0"
                        BorderThickness="3"
                        Background="#0B0D11">
                    <Grid RowDefinitions="*,12"
                          Margin="8">
                        <Border Grid.Row="0"
                                Margin="8,3,8,5"
                                CornerRadius="4"
                                BorderBrush="#DDE5E8F0"
                                BorderThickness="2" />
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="3">
                            <Border Width="5" Height="9" Background="#DDE5E8F0" />
                            <Border Width="5" Height="9" Background="#DDE5E8F0" />
                            <Border Width="5" Height="9" Background="#DDE5E8F0" />
                            <Border Width="5" Height="9" Background="#DDE5E8F0" />
                            <Border Width="5" Height="9" Background="#DDE5E8F0" />
                        </StackPanel>
                    </Grid>
                </Border>

                </StackPanel>

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding ShowLauncherBranding}">
                    <Image Source="{Binding SelectedGame.LauncherLogoImage}"
                           Width="220"
                           Height="64"
                           Stretch="Uniform" />

                    <TextBlock Text="{Binding SelectedGame.Launcher, StringFormat='LAUNCH VIA {0}'}"
                               HorizontalAlignment="Center"
                               Foreground="{Binding SelectedGame.AccentBrightColor}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               LetterSpacing="3" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Spacing="5"
                            IsVisible="{Binding HasCustomCollection}">
                    <Image Source="{Binding CollectionLogoImage}"
                           Width="164"
                           Height="164"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           IsVisible="{Binding HasCollectionLogo}" />
                    <TextBlock Text="{Binding Collection.Name}"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               LetterSpacing="1.5"
                               IsVisible="{Binding HasNoCollectionLogo}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    ZIndex="20"
                    Classes="controller-indicator"
                    Classes.connected="{Binding IsControllerConnected}"
                    Width="64" Height="44"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    CornerRadius="0"
                    BorderThickness="0"
                    ToolTip.Tip="{Binding ControllerStatus}"
                    AutomationProperties.Name="Controller connection status">
                <Canvas Width="58" Height="42"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Path Data="M9,7 Q13,3 19,4 L21,6 H37 L39,4 Q45,3 49,7 Q53,12 55,21 L57,31 Q58,37 53,40 L47,42 L39,34 Q37,32 34,32 H24 Q21,32 19,34 L11,42 L5,40 Q0,37 1,31 L3,21 Q5,12 9,7 Z"
                          StrokeThickness="2.4"
                          Fill="Transparent" />
                    <Path Data="M14,13 L14,21 M10,17 L18,17"
                          StrokeThickness="2" />
                    <Ellipse Canvas.Left="12" Canvas.Top="10" Width="4" Height="4" Fill="Transparent" StrokeThickness="1.6" />
                    <Ellipse Canvas.Left="20" Canvas.Top="23" Width="7" Height="7" Fill="Transparent" StrokeThickness="1.8" />
                    <Ellipse Canvas.Left="34" Canvas.Top="23" Width="7" Height="7" Fill="Transparent" StrokeThickness="1.8" />
                    <Ellipse Canvas.Left="43" Canvas.Top="11" Width="3.5" Height="3.5" Fill="Transparent" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="47" Canvas.Top="15" Width="3.5" Height="3.5" Fill="Transparent" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="39" Canvas.Top="15" Width="3.5" Height="3.5" Fill="Transparent" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="43" Canvas.Top="19" Width="3.5" Height="3.5" Fill="Transparent" StrokeThickness="1.4" />
                    <Ellipse Canvas.Left="26" Canvas.Top="7" Width="6" Height="6" Fill="Transparent" StrokeThickness="1.6" />
                    <Ellipse Canvas.Left="23" Canvas.Top="15" Width="2.5" Height="2.5" Fill="Transparent" StrokeThickness="1.2" />
                    <Ellipse Canvas.Left="33" Canvas.Top="15" Width="2.5" Height="2.5" Fill="Transparent" StrokeThickness="1.2" />
                </Canvas>
            </Border>

            <Grid Grid.Row="0">

                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasGames}">
                    <ItemsControl ItemsSource="{Binding Shelves}"
                                  Margin="18,4"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameShelfViewModel">
                                <StackPanel Spacing="2" Margin="0,0,0,8"
                                            HorizontalAlignment="Center">
                                    <StackPanel Margin="10,0" HorizontalAlignment="Center"
                                                IsVisible="{Binding HasName}">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   LetterSpacing="2" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Games}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="1210" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GameCardViewModel">
                                                <Button Classes="game-card"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Margin="5"
                                                        Command="{Binding OpenCommand}"
                                                        AutomationProperties.Name="{Binding Name}"
                                                        ToolTip.Tip="{Binding Name}">
                                                    <StackPanel Width="140" Spacing="4">
                                                        <Grid>
                                                            <Border Classes="card-frame" Width="140" Height="229"
                                                                    CornerRadius="7" Background="#F207090D"
                                                                    BorderBrush="{Binding AccentBrightColor}"
                                                                    BorderThickness="2" Opacity="0.92">
                                                                <Grid RowDefinitions="23,2,204">
                                                                    <Border Grid.Row="0" Background="{Binding AccentColor}"
                                                                            CornerRadius="5,5,0,0"
                                                                            IsVisible="{Binding HasNoLauncherBanner}">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center" Spacing="5">
                                                                            <Border Width="9" Height="9" CornerRadius="5"
                                                                                    BorderBrush="White" BorderThickness="2" />
                                                                            <TextBlock Text="{Binding Launcher}"
                                                                                       Foreground="White" FontSize="9"
                                                                                       FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Grid.Row="0" CornerRadius="5,5,0,0"
                                                                            ClipToBounds="True"
                                                                            IsVisible="{Binding HasLauncherBanner}">
                                                                        <Image Source="{Binding LauncherBannerImage}"
                                                                               Stretch="Fill"
                                                                               HorizontalAlignment="Stretch"
                                                                               VerticalAlignment="Stretch" />
                                                                    </Border>
                                                                    <Border Grid.Row="1" Background="White" />
                                                                    <Grid Grid.Row="2" Background="#0A0C10" ClipToBounds="True">
                                                                        <Image Source="{Binding CoverImage}"
                                                                               Stretch="Uniform"
                                                                               IsVisible="{Binding HasCover}" />
                                                                        <Border Width="58" Height="58" CornerRadius="29"
                                                                                BorderBrush="{Binding AccentColor}"
                                                                                BorderThickness="2"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                IsVisible="{Binding HasNoCover}">
                                                                            <TextBlock Text="{Binding Initials}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="White" FontSize="19"
                                                                                       FontWeight="Bold" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                            <Border Classes="selection-card-accent" CornerRadius="7"
                                                                    BorderBrush="{Binding AccentBrightColor}"
                                                                    BorderThickness="4" IsHitTestVisible="False" />
                                                            <Border Classes="selection-title-pulse selection-card-pulse"
                                                                    Margin="3" CornerRadius="5" BorderBrush="White"
                                                                    BorderThickness="2" IsHitTestVisible="False" />
                                                        </Grid>
                                                        <Border Height="3" CornerRadius="2"
                                                                Background="{Binding AccentBrightColor}"
                                                                IsVisible="{Binding IsSelected}" />
                                                        <Grid Height="40">
                                                            <Border Background="{Binding AccentMutedColor}"
                                                                    CornerRadius="6" IsVisible="{Binding IsSelected}" />
                                                            <Border Margin="-7,-5" CornerRadius="9"
                                                                    BorderBrush="{Binding AccentBrightColor}"
                                                                    BorderThickness="4" IsVisible="{Binding IsSelected}" />
                                                            <Border Classes="selection-title-pulse" Margin="-10,-8"
                                                                    CornerRadius="12" BorderBrush="White"
                                                                    BorderThickness="2" IsVisible="{Binding IsSelected}" />
                                                            <TextBlock Text="{Binding Name}" Margin="4,2"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                                       MaxLines="3" TextTrimming="CharacterEllipsis"
                                                                       Foreground="#F2FFFFFF" FontSize="11"
                                                                       FontWeight="SemiBold" LineHeight="11" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <Border IsVisible="{Binding ShowEmptyLibrary}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="680"
                        Padding="38"
                        CornerRadius="12"
                        Background="#F0000000"
                        BorderBrush="#C08AFF"
                        BorderThickness="3">
                <StackPanel Spacing="12">
                    <Border Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            CornerRadius="36"
                            BorderBrush="#C08AFF"
                            BorderThickness="3">
                        <TextBlock Text="!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="NO GAMES FOUND"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="Copy a game folder from Games/Examples into Games, then press F5."
                               MaxWidth="560"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#AFFFFFFF"
                               FontSize="15" />
                    <TextBlock Text="{Binding PortableRoot}"
                               MaxWidth="760"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#7FFFFFFF"
                               FontSize="12" />
                    <Button Classes="action"
                            Content="REFRESH LIBRARY"
                            Command="{Binding ReloadCommand}"
                            BorderBrush="#C08AFF"
                            BorderThickness="2"
                            HorizontalAlignment="Center" />
                </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasLibraryError}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="680" Padding="38" CornerRadius="12"
                        Background="#F0000000" BorderBrush="#FFFF6B72"
                        BorderThickness="3">
                    <StackPanel Spacing="14">
                        <TextBlock Text="LIBRARY UNAVAILABLE" HorizontalAlignment="Center"
                                   Foreground="White" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="{Binding LibraryErrorMessage}" MaxWidth="560"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="#DFFFFFFF" FontSize="15" />
                        <TextBlock Text="Check the Logs folder for technical details."
                                   HorizontalAlignment="Center" Foreground="#8FFFFFFF"
                                   FontSize="12" />
                        <Button Classes="action" Content="TRY AGAIN"
                                AutomationProperties.Name="Retry loading library"
                                Command="{Binding ReloadCommand}" BorderBrush="#FFFF6B72"
                                BorderThickness="2" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="14">
                <Button Classes="action"
                        Command="{Binding OpenSelectedGameCommand}"
                        IsEnabled="{Binding HasSelectedGame}"
                        IsVisible="{Binding ShowOnScreenActionButtons}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <controls:ButtonPromptBadge Label="{Binding ConfirmPrompt}" BadgeColor="#2E9B32"/>
                        <TextBlock Text="VIEW DETAILS"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="action"
                        Command="{Binding ExitCommand}"
                        IsVisible="{Binding ShowOnScreenActionButtons}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10">
                        <controls:ButtonPromptBadge Label="{Binding BackPrompt}" BadgeColor="#C83B40"/>
                        <TextBlock Text="EXIT"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Classes="action"
                        Command="{Binding OpenAvailableUpdateCommand}"
                        IsVisible="{Binding HasAvailableUpdate}"
                        BorderBrush="#C08AFF"
                        BorderThickness="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="↓" Foreground="#C08AFF"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="UPDATE AVAILABLE"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border IsVisible="{Binding IsLoading}"
                ZIndex="100"
                Background="#FC030406">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">
                <Image Source="/Assets/AppIcon.png"
                       Width="112"
                       Height="112"
                       Stretch="Uniform"
                       AutomationProperties.Name="Cart Launch Companion cartridge logo" />
                <StackPanel Spacing="5">
                    <TextBlock Text="BUILDING YOUR CART"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="19"
                               FontWeight="Bold"
                               LetterSpacing="3" />
                    <TextBlock Text="Finding games and preparing artwork"
                               HorizontalAlignment="Center"
                               Foreground="#8FFFFFFF"
                               FontSize="12" />
                </StackPanel>
                <controls:LoadingThrobber Accent="#C08AFF"
                                          HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>



