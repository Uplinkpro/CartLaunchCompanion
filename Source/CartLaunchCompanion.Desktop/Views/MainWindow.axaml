<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartLaunchCompanion.Desktop.ViewModels"
        xmlns:views="using:CartLaunchCompanion.Desktop.Views"
        xmlns:controls="using:CartLaunchCompanion.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="CartLaunchCompanion.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="Cart Launch Companion 2.0">

    <Grid Background="#030406">
        <views:HomeView IsVisible="{Binding IsHomeVisible}" />
        <views:MetadataView IsVisible="{Binding IsMetadataVisible}" />

        <Grid IsVisible="{Binding IsExitVisible}"
              ZIndex="500">
            <controls:StudioEnvironmentControl />

            <Border Background="#B2030406" />

            <Grid RowDefinitions="*,Auto"
                  Margin="42">
                <Border Grid.Row="0"
                        Classes="glass-panel"
                        Width="620"
                        Height="310"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="42">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <Border Width="86"
                                Height="70"
                                CornerRadius="11"
                                BorderBrush="#E5E8EDF3"
                                BorderThickness="3"
                                Background="#0B0D11">
                            <Grid RowDefinitions="*,13"
                                  Margin="9">
                                <Border Grid.Row="0"
                                        Margin="8,3,8,5"
                                        CornerRadius="4"
                                        BorderBrush="#E5E8EDF3"
                                        BorderThickness="2" />

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="chrome-title"
                                   Text="EXIT CART LAUNCH COMPANION?"
                                   HorizontalAlignment="Center"
                                   FontSize="30" />

                        <TextBlock Classes="muted"
                                   Text="Press B again to exit, or A to cancel."
                                   HorizontalAlignment="Center"
                                   FontSize="15" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="220,24,220"
                      HorizontalAlignment="Center">
                    <Button Grid.Column="0"
                            Classes="action"
                            Command="{Binding CancelExitCommand}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#2E9B32">
                                <TextBlock Text="{Binding ConfirmPrompt}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="CANCEL"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Classes="action exit-action"
                            Command="{Binding ConfirmExitCommand}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Border Width="30"
                                    Height="30"
                                    CornerRadius="15"
                                    Background="#C83B40">
                                <TextBlock Text="{Binding BackPrompt}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="EXIT"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>


