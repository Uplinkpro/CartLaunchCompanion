<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CartLaunchCompanion.Desktop.ViewModels"
        xmlns:views="using:CartLaunchCompanion.Desktop.Views"
        xmlns:controls="using:CartLaunchCompanion.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="CartLaunchCompanion.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowDecorations="None"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen"
        Title="Cart Launch Companion"
        Icon="/Assets/AppIcon.png">

    <Window.Styles>
        <Style Selector="Grid.page-transition.active.motion">
            <Style.Animations>
                <Animation Duration="0:0:0.24"
                           IterationCount="1"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Grid.exit-transition.active.motion">
            <Style.Animations>
                <Animation Duration="0:0:0.18"
                           IterationCount="1"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Grid.metadata-loading.active.motion">
            <Style.Animations>
                <Animation Duration="0:0:0.16"
                           IterationCount="1"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Canvas.loading-spinner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform">
                <RotateTransform Angle="0" />
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.85"
                           IterationCount="Infinite"
                           Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <!-- A fixed 1280x720 presentation canvas scales cleanly to 2560x1440.
         Steam Deck's 1280x800 display retains the intended 16:9 composition
         with true-black 40px letterbox bands instead of stretching the UI. -->
    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Width="1280" Height="720" Background="#030406">
        <views:HomeView IsVisible="{Binding IsHomeVisible}" />
        <views:VersionPickerView IsVisible="{Binding IsVersionPickerVisible}" />
        <views:MetadataView IsVisible="{Binding IsMetadataVisible}" />

        <Grid IsVisible="{Binding IsMetadataLoading}"
              Classes="metadata-loading"
              Classes.active="{Binding IsMetadataLoading}"
              Classes.motion="{Binding UseMotionEffects}"
              ZIndex="450">
            <Border Background="#FF030406" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                <Image Source="{Binding LoadingGame.CoverImage}"
                       Width="150"
                       Height="225"
                       Stretch="Uniform" />
                <Canvas Classes="loading-spinner"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center">
                    <Ellipse Canvas.Left="4" Canvas.Top="4"
                             Width="44" Height="44"
                             Stroke="#24FFFFFF"
                             StrokeThickness="4" />
                    <Path Data="M26,4 A22,22 0 0 1 48,26"
                          Stroke="{Binding LoadingGame.AccentBrightColor}"
                          StrokeThickness="4"
                          StrokeLineCap="Round" />
                </Canvas>
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsLaunchTransitionVisible}"
              Classes="metadata-loading"
              Classes.active="{Binding IsLaunchTransitionVisible}"
              Classes.motion="{Binding UseMotionEffects}"
              ZIndex="500">
            <Border Background="#F5030406" />
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="22">
                <Image Source="{Binding LaunchingGame.CoverImage}"
                       Width="160"
                       Height="240"
                       Stretch="Uniform" />
                <Canvas Classes="loading-spinner"
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Center">
                    <Ellipse Canvas.Left="4" Canvas.Top="4"
                             Width="48" Height="48"
                             Stroke="#28FFFFFF"
                             StrokeThickness="4" />
                    <Path Data="M28,4 A24,24 0 0 1 52,28"
                          Stroke="{Binding LaunchingGame.AccentBrightColor}"
                          StrokeThickness="4"
                          StrokeLineCap="Round" />
                </Canvas>
                <TextBlock Text="LAUNCHING"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           LetterSpacing="4"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LaunchingGame.Name}"
                           Foreground="#CFFFFFFF"
                           FontSize="16"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding IsUpdateVisible}" ZIndex="600">
            <Border Background="#D8030406" />
            <Grid RowDefinitions="*,Auto" Margin="42">
            <Border Grid.Row="0" Width="650" MinHeight="270" Padding="42"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14" Background="#FA0B0D11"
                    BorderBrush="#C08AFF" BorderThickness="3">
                <StackPanel Spacing="18">
                    <TextBlock Text="SECURE MAINTENANCE" Foreground="#C08AFF"
                               FontSize="12" FontWeight="Bold" LetterSpacing="3"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateTitle}" Foreground="White"
                               FontSize="28" FontWeight="Bold" TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateMessage}" Foreground="#CFFFFFFF"
                               FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="540" HorizontalAlignment="Center" />
                    <ProgressBar Minimum="0" Maximum="100" Height="8"
                                 Value="{Binding UpdateProgress}"
                                 IsVisible="{Binding IsUpdateBusy}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"
                        IsVisible="{Binding ShowOnScreenActionButtons}">
                <Button Classes="action" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding HasAvailableUpdate}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:ButtonPromptBadge Label="{Binding ConfirmPrompt}" BadgeColor="#2E9B32" />
                        <TextBlock Text="{Binding UpdateActionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="action" Command="{Binding CheckForUpdatesCommand}" IsVisible="{Binding !HasAvailableUpdate}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:ButtonPromptBadge Label="{Binding ConfirmPrompt}" BadgeColor="#2E9B32" />
                        <TextBlock Text="{Binding UpdateActionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="action" Command="{Binding CloseUpdateCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <controls:ButtonPromptBadge Label="{Binding BackPrompt}" BadgeColor="#C83B40" />
                        <TextBlock Text="CLOSE" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsExitVisible}"
              Classes="exit-transition"
              Classes.active="{Binding IsExitVisible}"
              Classes.motion="{Binding UseMotionEffects}"
              ZIndex="500">
            <controls:StudioRenderer ShowArchitecture="True" />

            <Image Source="{Binding SelectedGame.BackgroundImage}"
                   Stretch="UniformToFill" Opacity="0.14" Margin="-24" />
            <Image Source="{Binding SelectedGame.HeroImage}"
                   IsVisible="{Binding SelectedGame.HasHeroOnly}"
                   Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Top" Opacity="0.14" />

            <Border Background="#B2030406" />

            <Grid RowDefinitions="*,Auto,Auto"
                  Margin="42">
                <Border Grid.Row="0"
                        Classes="glass-panel"
                        Width="620"
                        Height="310"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="42"
                        Background="#F0000000"
                        BorderBrush="{Binding SelectedGame.AccentBrightColor}"
                        BorderThickness="3">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <Border Width="86"
                                Height="70"
                                CornerRadius="11"
                                BorderBrush="#E5E8EDF3"
                                BorderThickness="3"
                                Background="#0B0D11">
                            <Grid RowDefinitions="*,13"
                                  Margin="9">
                                <Border Grid.Row="0"
                                        Margin="8,3,8,5"
                                        CornerRadius="4"
                                        BorderBrush="#E5E8EDF3"
                                        BorderThickness="2" />

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="3">
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                    <Border Width="6" Height="10" Background="#E5E8EDF3" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="chrome-title"
                                   Text="EXIT CART LAUNCH COMPANION?"
                                   HorizontalAlignment="Center"
                                   FontSize="30" />

                        <Border Width="180"
                                Height="4"
                                CornerRadius="2"
                                Background="{Binding SelectedGame.AccentBrightColor}" />

                        <TextBlock Classes="muted"
                                   Text="{Binding ExitInstruction}"
                                   HorizontalAlignment="Center"
                                   FontSize="15" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14"
                      HorizontalAlignment="Center">
                    <Button Classes="action"
                            BorderBrush="{Binding SelectedGame.AccentBrightColor}"
                            BorderThickness="2"
                            AutomationProperties.Name="Cancel exit"
                            Command="{Binding CancelExitCommand}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <controls:ButtonPromptBadge Label="{Binding ConfirmPrompt}" BadgeColor="#2E9B32" />

                            <TextBlock Text="CANCEL"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="action exit-action"
                            AutomationProperties.Name="Exit Cart Launch Companion"
                            Command="{Binding ConfirmExitCommand}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <controls:ButtonPromptBadge Label="{Binding BackPrompt}" BadgeColor="#C83B40" />

                            <TextBlock Text="EXIT"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="action"
                            IsVisible="{Binding IsSafeEjectAvailable}"
                            BorderBrush="{Binding SelectedGame.AccentBrightColor}" BorderThickness="2"
                            AutomationProperties.Name="Safely eject game cart"
                            Command="{Binding EjectCartCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <controls:ButtonPromptBadge Label="{Binding EjectPrompt}" BadgeColor="#2F80ED" />
                            <TextBlock Text="EJECT CART" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="{Binding EjectStatus}" Classes="muted"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="700" />
            </Grid>
        </Grid>

    </Grid>
    </Viewbox>
</Window>



