<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="EmulatorUpdateOverlayBrush">#E8030406</SolidColorBrush>
    <SolidColorBrush x:Key="EmulatorUpdateSurfaceBrush">#0B0D11</SolidColorBrush>
    <SolidColorBrush x:Key="EmulatorUpdateAccentBrush">#C08AFF</SolidColorBrush>
    <SolidColorBrush x:Key="EmulatorUpdateTextBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="EmulatorUpdateMutedBrush">#CFFFFFFF</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Border.emulatorUpdateOverlay">
    <Setter Property="Background" Value="{DynamicResource EmulatorUpdateOverlayBrush}" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style Selector="Border.emulatorUpdatePanel">
    <Setter Property="Background" Value="{DynamicResource EmulatorUpdateSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EmulatorUpdateAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="MaxWidth" Value="760" />
    <Setter Property="MaxHeight" Value="620" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.emulatorUpdateContent">
    <Setter Property="Spacing" Value="18" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="TextBlock.emulatorUpdateTitle">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource EmulatorUpdateTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.emulatorUpdateCopy">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource EmulatorUpdateMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="WrapPanel.emulatorUpdateActions > Button">
    <Setter Property="Margin" Value="0,0,10,10" />
  </Style>
</Styles>