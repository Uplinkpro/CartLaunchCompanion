<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CartLaunchCompanion.Desktop.App"
             xmlns:local="using:CartLaunchCompanion.Desktop"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Themes/MetadataTheme.axaml" />

        <Style Selector="Window">
            <Setter Property="Background" Value="#000000" />
            <Setter Property="FontFamily"
                    Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="MinWidth" Value="188" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#E0000000" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="#F0080808" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
        </Style>

        <Style Selector="Button.action:focus">
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.exit-action">
            <Setter Property="Background" Value="#E0180004" />
            <Setter Property="BorderBrush" Value="#E45C3238" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.exit-action:pointerover">
            <Setter Property="Background" Value="#F13C1117" />
            <Setter Property="BorderBrush" Value="#FFFF6B72" />
        </Style>

        <Style Selector="Button.game-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.game-card Border.card-frame">
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="RenderTransform"
                    Value="scale(1) translate(0px, 0px)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.game-card:pointerover Border.card-frame">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RenderTransform"
                    Value="scale(1) translate(0px, 0px)" />
        </Style>

        <Style Selector="Button.game-card:focus Border.card-frame">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform"
                    Value="scale(1.04) translate(0px, -8px)" />
        </Style>

        <Style Selector="Button.game-card.selected Border.card-frame">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform"
                    Value="scale(1) translate(0px, 0px)" />
        </Style>

        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#E0000000" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBlock.chrome-title">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9FFFFFFF" />
        </Style>

        <Style Selector="Border.exit-confirmation-panel">
            <Setter Property="Background" Value="#F0000000" />
            <Setter Property="BorderBrush" Value="#56FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Border.exit-confirmation-divider">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#70FFFFFF" />
        </Style>

        <Style Selector="Border.ra-panel">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#D112151A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.ra-heading">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ra-award">
            <Setter Property="Foreground" Value="#F5C451" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>

        <Style Selector="ProgressBar.ra-loading">
            <Setter Property="Height" Value="3" />
            <Setter Property="MinHeight" Value="3" />
        </Style>

        <Style Selector="TextBlock.ra-progress">
            <Setter Property="Foreground" Value="#E8FFFFFF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.ra-points">
            <Setter Property="Foreground" Value="#F5C451" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Grid.ra-badge">
            <Setter Property="Margin" Value="0,3,6,3" />
            <Setter Property="Height" Value="52" />
        </Style>

        <Style Selector="Border.ra-badge-image-frame">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#FF20242B" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ra-badge-fallback">
            <Setter Property="Foreground" Value="#F5C451" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ra-badge-title">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.ra-badge-points">
            <Setter Property="Foreground" Value="#CFFFFFFF" />
            <Setter Property="FontSize" Value="9" />
        </Style>

        <Style Selector="TextBlock.ra-badge-earned">
            <Setter Property="Foreground" Value="#66E38A" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
    </Application.Styles>
</Application>




