<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CartLaunchCompanion.Desktop.App"
             xmlns:local="using:CartLaunchCompanion.Desktop"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="#030406" />
            <Setter Property="FontFamily"
                    Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>

        <Style Selector="Button.action">
            <Setter Property="MinWidth" Value="188" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#D90A0C10" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Button.action:pointerover">
            <Setter Property="Background" Value="#F014171D" />
            <Setter Property="BorderBrush" Value="#88FFFFFF" />
        </Style>

        <Style Selector="Button.action:focus">
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.exit-action">
            <Setter Property="Background" Value="#D22C0B10" />
            <Setter Property="BorderBrush" Value="#E45C3238" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.exit-action:pointerover">
            <Setter Property="Background" Value="#F13C1117" />
            <Setter Property="BorderBrush" Value="#FFFF6B72" />
        </Style>

        <Style Selector="Button.game-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.game-card Border.card-frame">
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="RenderTransform"
                    Value="scale(1) translate(0px, 0px)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.game-card:pointerover Border.card-frame">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RenderTransform"
                    Value="scale(1.025) translate(0px, -5px)" />
        </Style>

        <Style Selector="Button.game-card:focus Border.card-frame">
            <Setter Property="BorderThickness" Value="3" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform"
                    Value="scale(1.04) translate(0px, -8px)" />
        </Style>

        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#D90A0C10" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="TextBlock.chrome-title">
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9FFFFFFF" />
        </Style>
    </Application.Styles>
</Application>
