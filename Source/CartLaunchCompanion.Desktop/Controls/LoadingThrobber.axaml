<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CartLaunchCompanion.Desktop.Controls.LoadingThrobber"
             x:Name="Root"
             Width="64"
             Height="18"
             Focusable="False">
  <UserControl.Styles>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Opacity" Value="0.22" />
    </Style>
    <Style Selector="Ellipse.dot.one">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.dot.two">
      <Style.Animations>
        <Animation Duration="0:0:0.9" Delay="0:0:0.15" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.dot.three">
      <Style.Animations>
        <Animation Duration="0:0:0.9" Delay="0:0:0.3" IterationCount="Infinite" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="25%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.22" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="10">
    <Ellipse Classes="dot one" Fill="{Binding Accent, ElementName=Root}" />
    <Ellipse Classes="dot two" Fill="{Binding Accent, ElementName=Root}" />
    <Ellipse Classes="dot three" Fill="{Binding Accent, ElementName=Root}" />
  </StackPanel>
</UserControl>
