<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CartLaunchCompanion.Desktop.ViewModels"
             x:Class="CartLaunchCompanion.Desktop.Controls.StudioScene"
             x:DataType="vm:MainViewModel"
             IsHitTestVisible="False">
    <Grid Background="#030406">
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%"
                                     EndPoint="0%,100%">
                    <GradientStop Color="#050609" Offset="0" />
                    <GradientStop Color="#020305" Offset="0.63" />
                    <GradientStop Color="#07080B" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Clearly visible wide cone -->
        <Canvas Width="1100"
                Height="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
            <Polygon x:Name="WideBeam"
                     Points="470,0 630,0 950,590 150,590"
                     Opacity="0.34">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="{Binding SelectedGame.BeamCenterColor,
                                                      FallbackValue=#709D56E8}"
                                      Offset="0" />
                        <GradientStop Color="{Binding SelectedGame.FloorLightColor,
                                                      FallbackValue=#309D56E8}"
                                      Offset="0.55" />
                        <GradientStop Color="#009D56E8"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>

            <!-- Bright narrow core -->
            <Polygon x:Name="CoreBeam"
                     Points="515,0 585,0 730,565 370,565"
                     Opacity="0.56">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="{Binding SelectedGame.AccentBrightColor,
                                                      FallbackValue=#C08AFF}"
                                      Offset="0" />
                        <GradientStop Color="{Binding SelectedGame.BeamCenterColor,
                                                      FallbackValue=#709D56E8}"
                                      Offset="0.45" />
                        <GradientStop Color="#009D56E8"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>

            <!-- Soft moving haze inside the beam -->
            <Canvas x:Name="HazeLayer"
                    Width="1100"
                    Height="580"
                    Opacity="0.15">
                <Ellipse Width="500"
                         Height="145"
                         Canvas.Left="120"
                         Canvas.Top="145"
                         Fill="{Binding SelectedGame.BeamCenterColor,
                                        FallbackValue=#709D56E8}" />
                <Ellipse Width="570"
                         Height="165"
                         Canvas.Left="420"
                         Canvas.Top="320"
                         Fill="{Binding SelectedGame.BeamCenterColor,
                                        FallbackValue=#709D56E8}" />
            </Canvas>
        </Canvas>

        <Grid VerticalAlignment="Bottom"
              Height="205">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#090B0F" Offset="0" />
                        <GradientStop Color="#030406" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border Height="1"
                    VerticalAlignment="Top"
                    Background="#28FFFFFF" />

            <Border x:Name="FloorLight"
                    Width="740"
                    Height="155"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0.62">
                <Border.Background>
                    <RadialGradientBrush Center="50%,0%"
                                         GradientOrigin="50%,0%"
                                         RadiusX="0.65"
                                         RadiusY="0.65">
                        <GradientStop Color="{Binding SelectedGame.FloorLightColor,
                                                      FallbackValue=#309D56E8}"
                                      Offset="0" />
                        <GradientStop Color="#00000000"
                                      Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <Border BorderBrush="#65000000"
                BorderThickness="80,30,80,55" />
    </Grid>
</UserControl>
